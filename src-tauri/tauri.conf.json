{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eventor Album Designer",
  "version": "0.1.1",
  "identifier": "com.eventorcrm.albumdesigner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eventor Album Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "backgroundColor": "#1b1c21",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: album: http://album.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://wvdtbhfxdqxeeubfwmur.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Eventor",
    "copyright": "© 2026 Eventor",
    "category": "Photography",
    "shortDescription": "Design wedding albums and publish them to Eventor",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}